# ============================================================
#  RAG Chatbot Kit — cấu hình (sao chép thành ".env" rồi điền giá trị thật)
#  KHÔNG commit file ".env" thật (đã .gitignore).
# ============================================================

# ---- Xác thực dịch vụ (server-to-server) ----
# Dự án chủ quản gọi API kèm header "X-API-Key: <giá trị này>". Không có khái niệm
# đăng nhập/vai trò — 1 khoá tĩnh, đủ dùng cho dịch vụ nội bộ chỉ 1 hệ thống gọi vào.
API_KEY=doi-khoa-nay-thanh-chuoi-ngau-nhien-manh

# ---- AI (Google Gemini) — dùng chung cho embedding lẫn hỏi-đáp ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_MIN_INTERVAL_MS=4000        # giãn cách tối thiểu giữa 2 lượt gọi embedding (tránh vượt hạn mức RPM gói free) — đặt 0 nếu dùng gói trả phí
GEMINI_CHAT_TIMEOUT_MS=30000
RAG_TOP_K=8                              # số đoạn tri thức tối đa lấy về cho 1 câu hỏi
RAG_MAX_DISTANCE=0.35                    # ngưỡng khoảng cách cosine coi là "đủ liên quan" (thấp hơn = khắt khe hơn)

# ---- Kho tri thức (Postgres + pgvector) ----
# Chạy trong Docker (xem docker-compose.yml) thì giữ nguyên host=chatbot-postgres, port=5432 (compose tự
# ghi đè). Chạy "node server.js" trực tiếp ngoài Docker thì trỏ về host/port đã lộ ra ngoài (mặc định dưới).
CHATBOT_PG_HOST=127.0.0.1
CHATBOT_PG_PORT=5433
CHATBOT_PG_DATABASE=chatbot_kb
CHATBOT_PG_USER=chatbot
CHATBOT_PG_PASSWORD=doi-mat-khau-manh-o-day

# ---- Máy chủ ----
PORT=3200

# ---- Đồng bộ dữ liệu sản phẩm từ NovaCart (lib/productSync.js) ----
CHATBOT_NAMESPACE=novacart
NOVACART_API_BASE=http://localhost:8080
# Phải KHỚP với novacart.internal-secret trong backend/application.properties — dùng để backend Java
# xác thực request gọi vào GET /internal/kb/products (service-to-service, không phải JWT khách hàng).
NOVACART_INTERNAL_SECRET=doi-secret-nay-thanh-chuoi-ngau-nhien-khac-voi-api-key-o-tren
